        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingebouwde systeembewaking"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Встроенный системный мониторинг"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตรวจสอบระบบในตัว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dahili Sistem İzleme"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内置系统监控"
          }
        }
      }
    },
    "Built-in system monitoring detects volume, brightness, and keyboard backlight changes directly without requiring external apps.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die integrierte Systemüberwachung erkennt Änderungen der Lautstärke, Helligkeit und Tastaturbeleuchtung direkt, ohne dass externe Apps erforderlich sind."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le système intégré de suivi détecte les changements de volume, luminosité et éclairage du clavier sans l’aide d’applications externes."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내장 시스템 모니터링은 외부 앱 없이도 음량, 밝기 및 키보드 백라이트 변경 사항을 직접 감지합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingebouwde systeemmonitoring detecteert veranderingen in volume, helderheid en toetsenbordverlichting direct zonder dat hiervoor externe apps nodig zijn."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Встроенный мониторинг отслеживает громкость и яркость напрямую."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตรวจสอบระบบในตัวตรวจจับการเปลี่ยนแปลงระดับเสียง ความสว่าง และไฟแป้นพิมพ์โดยตรงโดยไม่ต้องใช้แอปภายนอก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerleşik sistem izleme, harici uygulamalar gerektirmeden ses düzeyi, parlaklık ve klavye arka aydınlatması değişikliklerini doğrudan algılar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内置系统监控直接检测音量、亮度和键盘背光变化，无需外部应用。"
          }
        }
      }
    },
