            "state": "translated",
            "value": "Animasyonları özelleştirmek için \"Boşta animasyonu\"nu etkinleştirin"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用「空闲动画」以自定义动画"
          }
        }
      }
    },
    "Enable \"Show cool face animation while inactivity\" to customize animations": {
