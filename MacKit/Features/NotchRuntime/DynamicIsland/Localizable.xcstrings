    "Disable Minimalistic UI to configure the standard notch media controls.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표준 노치 미디어 제어기를 설정하려면 '미니멀리즘 UI'를 비활성화하세요."
          }
