    "Controls the lock screen reminder chip and its positioning.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠금 화면 리마인더 칩과 그 위치를 제어합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beheert de herinneringschip voor het vergrendelscherm en de positionering ervan."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Управляет плашкой напоминаний на экране блокировки и ее позицией."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ควบคุมชิปการแจ้งเตือนหน้าจอล็อกและตำแหน่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilit ekranı hatırlatma çipini ve konumunu kontrol eder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制锁屏提醒标签及其位置。"
          }
        }
      }
    },
    "Controls whether Dynamic Island mirrors lock/unlock events with its own live activity and audible chimes.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic Island가 자체 실시간 현황 및 효과음과 함께 잠금/잠금 해제 이벤트를 연동할지 여부를 제어합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bepaalt of Dynamic Island vergrendelings- en ontgrendelingsgebeurtenissen weergeeft via zijn eigen live-activiteit en geluidssignalen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla se a Dynamic Island espelha eventos de bloqueio/desbloqueio com sua própria atividade ao vivo e sinos audíveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Управляет тем, дублирует ли Dynamic Island системные события блокировки/разблокировки своими Live Activity и звуками."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ควบคุมว่าไดนามิกไอแลนด์จะสะท้อนเหตุการณ์ล็อก/ปลดล็อกด้วยกิจกรรมสดและเสียงของตัวเองหรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic Island'ın kendi canlı etkinliği ve sesli çanları ile kilitleme/kilit açma olaylarını yansıtıp yansıtmadığını kontrol eder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制灵动岛是否通过自身的实时活动和提示音来响应锁屏/解锁事件。"
          }
        }
      }
    },
