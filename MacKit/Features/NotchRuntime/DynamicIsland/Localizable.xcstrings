    "Enable and style the media controls that appear above the system clock when the screen is locked.": {
      "comment": "A description of the media panel settings in the lock screen settings view.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면이 잠겨 있을 때 시스템 시계 위에 나타나는 미디어 제어기를 활성화하고 스타일을 지정합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel de mediabediening in en vorm deze die boven de systeemklok verschijnt wanneer het scherm is vergrendeld."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative e estilize os controles de mídia que aparecem acima do relógio do sistema quando a tela está bloqueada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включение и настройка плера над системными часами при заблокированном экране."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดใช้และจัดสไตล์ปุ่มควบคุมสื่อที่ปรากฏเหนือนาฬิการะบบเมื่อล็อกหน้าจอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran kilitliyken sistem saatinin üzerinde görünen medya denetimlerini etkinleştirin ve şekillendirin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用并设置屏幕锁定时系统时钟上方显示的媒体控制。"
