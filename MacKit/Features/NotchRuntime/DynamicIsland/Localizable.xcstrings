    "With %lld graphs enabled, the Dynamic Island will expand horizontally to accommodate all graphs in a single row.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그래프 %lld개가 활성화되면 모든 그래프를 한 줄에 표시할 수 있도록 Dynamic Island가 가로로 확장됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als %lld grafieken is ingeschakeld, wordt het Dynamic Island horizontaal uitgevouwen zodat alle grafieken in één rij kunnen worden geplaatst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com gráficos %lld ativados, a Ilha Dinâmica se expandirá horizontalmente para acomodar todos os gráficos em uma única linha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При %lld включенных графиках Dynamic Island расширится по горизонтали."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "With %lld graphs enabled, the Dynamic Island will expand horizontally to accommodate all graphs in a single row."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld grafikleri etkinleştirildiğinde, Dynamic Island tüm grafikleri tek bir satırda barındıracak şekilde yatay olarak genişleyecektir."
          }
        },
        "zh-Hans": {
