    "Your support funds software development learning for students in 9th–12th grade.": {
      "comment": "A footer note explaining the app's funding.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러분의 후원금은 9~12학년 학생들의 소프트웨어 개발 교육을 지원하는 데 사용됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jouw steun financiert het leren van softwareontwikkeling voor leerlingen in de 9e tot en met de 12e klas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша поддержка финансирует обучение студентов программированию."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การสนับสนุนของคุณเป็นทุนการเรียนรู้การพัฒนาซอฟต์แวร์สำหรับนักเรียนชั้น ม.3–ม.6"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Desteğiniz, 9-12. sınıftaki öğrencilerin yazılım geliştirme öğrenimini finanse ediyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的支持将资助高中生的软件开发学习。"
          }
        }
      }
    },
