            "value": "Enable \"Idle Animation\" to customize animations"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추천 번역 ⭐️: 애니메이션을 사용자 지정하려면 '유휴 상태 애니메이션'을 활성화하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel \"Inactieve animatie\" in om animaties aan te passen"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите \"Анимация бездействия\" для персональных анимаций."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดใช้ \"แอนิเมชันเมื่อไม่ได้ใช้งาน\" เพื่อปรับแต่งแอนิเมชัน"
