    "Disabled while external display brightness integration is active.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitgeschakeld terwijl de integratie van de helderheid van het externe beeldscherm actief is."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดใช้ขณะการผสานรวมความสว่างจอภายนอกทำงานอยู่"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用外接显示器亮度集成时不可用。"
          }
        }
      }
    },
    "Disabled while external display integration is active — brightness keys are handled by the external app.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "외부 디스플레이 연동이 활성화된 동안에는 비활성화됩니다. 밝기 키는 외부 앱에서 제어합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitgeschakeld terwijl externe beeldschermintegratie actief is: helderheidstoetsen worden afgehandeld door de externe app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключено при активной интеграции внешнего дисплея — клавиши яркости обрабатываются внешним приложением."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดใช้ขณะการผสานรวมจอภายนอกทำงานอยู่ — ปุ่มความสว่างถูกจัดการโดยแอปภายนอก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Harici ekran entegrasyonu etkinken devre dışı bırakılır; parlaklık tuşları harici uygulama tarafından yönetilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "外部显示器集成激活时已禁用——亮度键由外部应用处理。"
          }
        }
      }
    },
    "Disabled while external display volume integration is active.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitgeschakeld terwijl de integratie van het externe weergavevolume actief is."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดใช้ขณะการผสานรวมระดับเสียงจอภายนอกทำงานอยู่"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用外接显示器音量集成时不可用。"
          }
        }
      }
    },
    "Discrete transitions snap between Green (0–60%), Yellow (60–85%), and Red (85–100%).": {
      "comment": "A description of how the color-coded progress bars work when not using smooth transitions.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단계적 전환은 초록색(0~60%), 노란색(60~85%), 빨간색(85~100%) 구간에 맞춰 색상이 즉시 전환됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn discrete overgangen tussen groen (0–60%), geel (60–85%) en rood (85–100%)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transições discretas se encaixam entre Verde (0–60%), Amarelo (60–85%) e Vermelho (85–100%)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключено при активной интеграции BetterDisplay — приложение использует Cmd+Клавиши яркости для своего управления."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Discrete transitions snap between Green (0–60%), Yellow (60–85%), and Red (85–100%)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayrık geçişler Yeşil (%0–60), Sarı (%60–85) ve Kırmızı (%85–100) arasında geçiş yapar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离散过渡在绿色（0-60%）、黄色（60-85%）和红色（85-100%）之间切换。"
          }
        }
      }
    },
