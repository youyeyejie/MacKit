    "Custom liquid glass already renders with Apple's liquid material, so this option is managed automatically.": {
      "comment": "A description of the custom liquid blur option in the media settings. | A description of the custom liquid blur option in the media settings. | merge:ko:alt='사용자 지정 Liquid Glass는 이미 Apple의 Liquid Material로 렌더링되므로, 이 옵션은 자동으로 관리됩니다.'",
      "isCommentAutoGenerated": true,
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "커스텀 리퀴드 글래스는 이미 Apple의 리퀴드 마테리얼로 렌더링되므로, 이 옵션은 자동으로 관리됩니다."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 지정 리퀴드 글래스는 이미 Apple의 리퀴드 마테리얼로 렌더링되므로, 이 옵션은 자동으로 관리됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aangepaste Liquid Glass wordt al weergegeven met Apple Liquid Material, dus deze optie wordt automatisch geregeld."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Liquid Glass personalizado já renderiza com o Liquid Glass da Apple, então essa opção é gerenciada automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настраиваемая жидкость"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Custom liquid glass เรนเดอร์ด้วยวัสดุ liquid ของ Apple อยู่แล้ว ตัวเลือกนี้จึงถูกจัดการอัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özel sıvı cam zaten Apple'ın sıvı malzemesiyle işleniyor, dolayısıyla bu seçenek otomatik olarak yönetiliyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义液态玻璃已使用 Apple 的液态材质渲染，因此此选项将自动管理。"
          }
        }
      }
    },
