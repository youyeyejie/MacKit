    "Terminal opacity only affects the terminal backdrop; text stays fully opaque. Blur uses the system material behind the window.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De terminaldekking heeft alleen invloed op de terminalachtergrond; tekst blijft volledig ondoorzichtig. Blur maakt gebruik van het systeemmateriaal achter het raam."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความทึบเทอร์มินัลมีผลเฉพาะพื้นหลัง ข้อความยังคงทึบเต็มที่ เบลอใช้วัสดุระบบหลังหน้าต่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal opaklığı yalnızca terminal arka planını etkiler; metin tamamen opak kalır. Blur, pencerenin arkasındaki sistem malzemesini kullanır."
          }
        }
      }
    },
