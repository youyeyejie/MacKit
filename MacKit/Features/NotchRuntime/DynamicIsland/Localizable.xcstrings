    "Unlock advanced features and improve your experience. Upgrade now for more customizations!": {
      "comment": "merge:ko:alt='고급 기능을 잠금 해제하여 사용 경험을 향상하세요. 지금 업그레이드하고 더 많은 사용자화 기능을 즐겨보세요!'",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Unlock advanced features and improve your experience. Upgrade now for more customizations!"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Unlock advanced features and improve your experience. Upgrade now for more customizations!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte erweiterte Funktionen frei und verbessere deine Erfahrung. Upgrade jetzt für weitere Anpassungsmöglichkeiten!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock advanced features and improve your experience. Upgrade now for more customizations!"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock advanced features and improve your experience. Upgrade now for more customizations!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Unlock advanced features and improve your experience. Upgrade now for more customizations!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déverrouillez des fonctionnalités avancées et améliorez votre expérience. Mettez à niveau maintenant pour plus de personnalisations !"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Unlock advanced features and improve your experience. Upgrade now for more customizations!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sblocca le funzionalità avanzate e migliora la tua esperienza. Aggiorna ora per ulteriori personalizzazioni!"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "고급 설정을 해제해 경험을 향상하세요. 더 많은 맞춤화 설정을 지금 바로 업그레이드해서 즐기세요!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontgrendel geavanceerde functies en verbeter je ervaring. Upgrade nu voor meer aanpassingen!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odblokuj dodatkowe funkcje i ciesz się lepszymi możliwościami. Ulepsz teraz, aby móc bardziej dostosować ustawienia!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueie recursos avançados e melhore sua experiência. Atualize agora para mais personalizações!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте для себя расширенные возможности и улучшите свой пользовательский опыт. Обновите подписку прямо сейчас, чтобы получить больше настроек!"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปลดล็อกฟีเจอร์ขั้นสูงและปรับปรุงประสบการณ์ อัปเกรดเลยเพื่อการปรับแต่งเพิ่มเติม!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelişmiş özelliklerin kilidini açın ve deneyiminizi geliştirin. Daha fazla özelleştirme için şimdi yükseltin!"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Unlock advanced features and improve your experience. Upgrade now for more customizations!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解锁高级功能并提升您的体验。现在升级以获取更多自定义功能！"
          }
        }
      }
    },
