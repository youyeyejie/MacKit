    "Drag a control onto a slot or tap to place it in the first empty slot.": {
      "comment": "A description below the control palette that explains how users can interact with it.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제어기를 슬롯으로 드래그하거나, 탭하여 첫 번째 빈 슬롯에 배치하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep een besturingselement naar een slot of tik om het in het eerste lege slot te plaatsen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste um controle para um slot ou toque para colocá-lo no primeiro slot vazio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите элемент в слот или нажмите, чтобы добавить его в первый свободный слот."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลากปุ่มควบคุมไปยังช่องหรือแตะเพื่อวางในช่องว่างแรก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kontrolü bir yuvaya sürükleyin veya ilk boş yuvaya yerleştirmek için dokunun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将控件拖到插槽上或点击将其放在第一个空插槽中。"
          }
        }
      }
    },
    "Drag items between slots or drop from the palette to remap controls.": {
      "comment": "A description of how to interact with the music slot configuration view.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "슬롯 간에 항목을 드래그하거나 팔레트에서 드롭하여 제어기를 재배치하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep items tussen slots of zet ze neer uit het palet om de besturingselementen opnieuw toe te wijzen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste itens entre slots ou solte da paleta para remapear os controles."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетаскивайте элементы между слотами или сбрасывайте их с палитры для изменения управления."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลากรายการระหว่างช่องหรือวางจากจานสีเพื่อจัดเรียงปุ่มควบคุมใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrolleri yeniden eşlemek için öğeleri yuvalar arasında sürükleyin veya paletten bırakın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在插槽之间拖动项目或从面板中放置以重新映射控件。"
          }
        }
      }
    },
    "Drop a PNG, JPEG, TIFF, or ICNS file to add it to your icon library.": {
